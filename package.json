{
	"name": "zora-reader",
	"version": "0.1.0",
	"description": "Cross-platform EPUB translation and review notes for Obsidian.",
	"main": "src/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.build.json --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"postinstall": "patch-package",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"epub",
		"obsidian",
		"obsidian-plugin"
	],
	"author": "zfcl",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@types/react": "^18.0.8",
		"@types/react-dom": "^18.0.3",
		"@typescript-eslint/eslint-plugin": "^5.2.0",
		"@typescript-eslint/parser": "^5.2.0",
		"esbuild": "^0.28.2",
		"obsidian": "latest",
		"patch-package": "^8.0.1",
		"tslib": "^2.3.1",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"epubjs": "^0.3.93",
		"preact": "^10.5.15",
		"react": "npm:@preact/compat@^17.0.3",
		"react-dom": "npm:@preact/compat@^17.0.3",
		"react-reader": "^1.0.2",
		"use-local-storage-state": "^17.3.0"
	},
	"overrides": {
		"@xmldom/xmldom": "^0.8.10",
		"brace-expansion": "^1.1.18",
		"js-yaml": "^4.3.1"
	}
}
